@page "/users"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using PuntoVenta.Blazor.Models
@using PuntoVenta.Blazor.Services
@inject UserApiService UserApiService
@inject AuthSessionService AuthSessionService
@inject UserModeService UserModeService

<PageTitle>Administración de Usuarios — Punto de Venta</PageTitle>

<div class="section-gap">
    <div>
        <h1 style="font-size:var(--font-size-2xl); font-weight:var(--font-weight-bold); color:var(--color-text-primary); margin-bottom:4px; display:flex; align-items:center; gap:var(--spacing-sm);">
            <i class="ph ph-users"></i> Administración de Usuarios
        </h1>
        <p style="font-size:var(--font-size-sm); color:var(--color-text-secondary);">
            Gestiona los usuarios, roles y accesos al sistema.
        </p>
    </div>

    <div class="card">
        @if (!string.IsNullOrEmpty(_pageError))
        {
            <div class="alert alert--error" style="margin-bottom: var(--spacing-md);">
                <i class="ph ph-warning-circle"></i> @_pageError
            </div>
        }
        @if (!string.IsNullOrEmpty(_pageSuccess))
        {
            <div class="alert alert--success" style="margin-bottom: var(--spacing-md);">
                <i class="ph ph-check-circle"></i> @_pageSuccess
            </div>
        }

        <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--spacing-md); margin-bottom:var(--spacing-md); flex-wrap:wrap;">
            <button class="btn btn--primary" @onclick="OpenCreateModal">
                <i class="ph ph-plus-circle"></i> Nuevo Usuario
            </button>
            <div style="position:relative; width: 300px;">
                <input class="field-input" placeholder="Buscar usuario..." 
                       @bind="_searchTerm" @bind:event="oninput" style="padding-left: 36px;" />
                <i class="ph ph-magnifying-glass" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--color-text-secondary); pointer-events:none;"></i>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex-center" style="padding:var(--spacing-2xl);">
                <div class="loader-ring"></div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th class="align-center">Estado</th>
                            <th class="align-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td class="font-mono">@user.Username</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td><span class="badge badge--info">@user.RoleName</span></td>
                                <td class="align-center">
                                    @if (!user.IsActive)
                                    {
                                        <span class="badge badge--error">Inactivo</span>
                                    }
                                    else if (user.IsLocked)
                                    {
                                        <span class="badge badge--warning">Bloqueado</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--success">Activo</span>
                                    }
                                </td>
                                <td class="align-center">
                                    <div style="display:flex; gap:4px; justify-content:center;">
                                        <button class="btn btn--primary btn--sm" title="Editar" 
                                                disabled="@_isBusy" 
                                                @onclick="() => OpenEditModal(user)">
                                            <i class="ph ph-pencil"></i> Editar
                                        </button>
                                        @if (user.IsLocked)
                                        {
                                            <button class="btn btn--warning btn--sm" title="Desbloquear" 
                                                    disabled="@_isBusy" 
                                                    @onclick="() => UnlockUser(user.UserId)">
                                                <i class="ph ph-lock-key-open"></i> Desbloquear
                                            </button>
                                        }
                                        @if (user.IsActive)
                                        {
                                            <button class="btn btn--danger btn--sm" title="Desactivar" 
                                                    disabled="@(_isBusy || user.UserId == _currentUserId)" 
                                                    @onclick="() => DeactivateUser(user.UserId)">
                                                <i class="ph ph-user-minus"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn--success btn--sm" title="Activar" 
                                                    disabled="@_isBusy" 
                                                    @onclick="() => ActivateUser(user.UserId)">
                                                <i class="ph ph-user-plus"></i> Activar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_isModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">
                    <i class="@(_isEditing ? "ph ph-pencil" : "ph ph-user-plus")"></i> 
                    @(_isEditing ? "Editar Usuario" : "Crear Nuevo Usuario")
                </span>
                <button class="btn btn--ghost btn--icon" @onclick="CloseModalWithConfirmAsync"><i class="ph ph-x"></i></button>
            </div>
            
            @if (_isEditing)
            {
                <EditForm Model="_updateUser" OnValidSubmit="HandleUpdateUser">
                    <DataAnnotationsValidator />
                    <div class="modal-body form-grid form-grid-2">
                        <div class="field-group" style="grid-column: span 2;">
                            <label class="field-label">Nombre de Usuario</label>
                            <input type="text" class="field-input" value="@_editingUsername" disabled />
                        </div>
                        <div class="field-group" style="grid-column: span 2;">
                            <label class="field-label">Nombre Completo *</label>
                            <InputText class="field-input" @bind-Value="_updateUser.FullName" />
                            <ValidationMessage For="@(() => _updateUser.FullName)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group" style="grid-column: span 2;">
                            <label class="field-label">Correo Electrónico *</label>
                            <InputText class="field-input" type="email" @bind-Value="_updateUser.Email" />
                            <ValidationMessage For="@(() => _updateUser.Email)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group" style="grid-column: span 2;">
                            <label class="field-label">Rol *</label>
                            <InputSelect class="field-input" @bind-Value="_updateUser.RoleId">
                                <option value="0">Seleccione un rol</option>
                                @foreach (var role in _roles)
                                {
                                    <option value="@role.RoleId">@role.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _updateUser.RoleId)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_lastModifiedBy))
                        {
                            <div style="grid-column: span 2; margin-top:var(--spacing-md); font-size:var(--font-size-sm); color:var(--color-text-secondary); display:flex; align-items:center; gap:4px;">
                                <i class="ph ph-info"></i> Última modificación por: <strong>@_lastModifiedBy</strong> el @(_lastModifiedAt?.ToString("g") ?? "")
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert--error" style="grid-column: span 2;"><i class="ph ph-warning-circle"></i> @_errorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn--ghost" @onclick="CloseModalWithConfirmAsync">Cancelar</button>
                        <button type="submit" class="btn btn--primary" disabled="@_isSaving">
                            @if (_isSaving) { <text><i class="ph ph-hourglass-high"></i> Guardando...</text> } else { <text><i class="ph ph-floppy-disk"></i> Guardar Cambios</text> }
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="_newUser" OnValidSubmit="HandleCreateUser">
                <DataAnnotationsValidator />
                
                <div class="modal-body form-grid form-grid-2">
                    <div class="field-group" style="grid-column: span 2;">
                        <label class="field-label">Nombre de Usuario *</label>
                        <InputText class="field-input" @bind-Value="_newUser.Username" />
                        <ValidationMessage For="@(() => _newUser.Username)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    <div class="field-group">
                        <label class="field-label">Contraseña *</label>
                        <InputText class="field-input" type="password" @bind-Value="_newUser.Password" />
                        <ValidationMessage For="@(() => _newUser.Password)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    <div class="field-group">
                        <label class="field-label">Confirmar Contraseña *</label>
                        <InputText class="field-input" type="password" @bind-Value="_newUser.ConfirmPassword" />
                        <ValidationMessage For="@(() => _newUser.ConfirmPassword)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    <div class="field-group" style="grid-column: span 2;">
                        <label class="field-label">Nombre Completo *</label>
                        <InputText class="field-input" @bind-Value="_newUser.FullName" />
                        <ValidationMessage For="@(() => _newUser.FullName)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    <div class="field-group" style="grid-column: span 2;">
                        <label class="field-label">Correo Electrónico *</label>
                        <InputText class="field-input" type="email" @bind-Value="_newUser.Email" />
                        <ValidationMessage For="@(() => _newUser.Email)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    <div class="field-group" style="grid-column: span 2;">
                        <label class="field-label">Rol *</label>
                        <InputSelect class="field-input" @bind-Value="_newUser.RoleId">
                            <option value="0">Seleccione un rol</option>
                            @foreach (var role in _roles)
                            {
                                <option value="@role.RoleId">@role.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _newUser.RoleId)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert--error" style="grid-column: span 2;"><i class="ph ph-warning-circle"></i> @_errorMessage</div>
                    }
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn--ghost" @onclick="CloseModalWithConfirmAsync">Cancelar</button>
                    <button type="submit" class="btn btn--primary" disabled="@_isSaving">
                        @if (_isSaving) { <text><i class="ph ph-hourglass-high"></i> Guardando...</text> } else { <text><i class="ph ph-floppy-disk"></i> Guardar Usuario</text> }
                    </button>
                </div>
                </EditForm>
            }
        </div>
    </div>
}

<ConfirmModal @ref="_confirmModal" />

@code {
    private List<UserModel> _users = [];
    private List<RoleModel> _roles = [];
    private bool _isLoading = true;
    
    private bool _isModalOpen = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string _errorMessage = string.Empty;
    private string _pageError = string.Empty;
    private string _pageSuccess = string.Empty;
    private CreateUserModel _newUser = new();
    private UpdateUserModel _updateUser = new();
    private string _editingUsername = string.Empty;
    private string? _lastModifiedBy;
    private DateTime? _lastModifiedAt;
    private int _currentUserId;
    private bool _isBusy;
    private ConfirmModal? _confirmModal;
    private string _searchTerm = string.Empty;

    private IEnumerable<UserModel> FilteredUsers => string.IsNullOrWhiteSpace(_searchTerm)
        ? _users
        : _users.Where(u => 
            u.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            u.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        UserModeService.OnShortcutPressed += HandleShortcut;
        var session = await AuthSessionService.GetCurrentSessionAsync();
        if (session is not null)
        {
            _currentUserId = session.UserId;
        }
        await LoadDataAsync();
    }

    public void Dispose()
    {
        UserModeService.OnShortcutPressed -= HandleShortcut;
    }

    private async void HandleShortcut(string key)
    {
        if (key == "Escape" && _isModalOpen && _confirmModal != null && !_confirmModal.IsVisible)
        {
            await InvokeAsync(CloseModalWithConfirmAsync);
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _users = await UserApiService.GetAllAsync();
        _roles = await UserApiService.GetRolesAsync();
        _isLoading = false;
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _newUser = new CreateUserModel();
        _errorMessage = string.Empty;
        _lastModifiedBy = null;
        _lastModifiedAt = null;
        _isModalOpen = true;
    }

    private void OpenEditModal(UserModel user)
    {
        _isEditing = true;
        _editingUsername = user.Username;
        _updateUser = new UpdateUserModel
        {
            UserId = user.UserId,
            FullName = user.FullName,
            Email = user.Email ?? string.Empty,
            RoleId = user.RoleId
        };
        _errorMessage = string.Empty;
        _lastModifiedBy = user.LastModifiedBy;
        _lastModifiedAt = user.LastModifiedAt;
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
    }

    private async Task CloseModalWithConfirmAsync()
    {
        if (_confirmModal == null) return;
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de descartar los cambios? Se perderán los datos ingresados.", "Cancelar edición", "Sí, descartar");
        if (confirmed)
        {
            _isModalOpen = false;
            StateHasChanged();
        }
    }

    private async Task HandleCreateUser()
    {
        if (_newUser.RoleId <= 0)
        {
            _errorMessage = "Debe seleccionar un rol válido.";
            return;
        }

        _isSaving = true;
        _errorMessage = string.Empty;

        var (success, error) = await UserApiService.CreateAsync(_newUser);

        if (success)
        {
            await LoadDataAsync();
            CloseModal();
        }
        else
        {
            _errorMessage = error;
        }

        _isSaving = false;
    }

    private async Task HandleUpdateUser()
    {
        if (_updateUser.RoleId <= 0)
        {
            _errorMessage = "Debe seleccionar un rol válido.";
            return;
        }

        _isSaving = true;
        _errorMessage = string.Empty;

        var (success, error) = await UserApiService.UpdateAsync(_updateUser);

        if (success)
        {
            await LoadDataAsync();
            CloseModal();
        }
        else
        {
            _errorMessage = error;
        }

        _isSaving = false;
    }

    private async Task UnlockUser(int userId)
    {
        if (_confirmModal is null) return;
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de que desea desbloquear a este usuario?", "Desbloquear usuario", "Desbloquear");
        if (!confirmed) return;

        _pageError = string.Empty;
        _pageSuccess = string.Empty;
        _isBusy = true;
        try
        {
            var success = await UserApiService.UnlockAsync(userId);
            if (!success)
            {
                _pageError = "No se pudo desbloquear el usuario.";
            }
            else
            {
                _pageSuccess = "Usuario desbloqueado correctamente.";
            }
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeactivateUser(int userId)
    {
        if (_confirmModal is null) return;
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de que desea desactivar a este usuario? Ya no podrá iniciar sesión en el sistema.", "Desactivar usuario", "Desactivar");
        if (!confirmed) return;

        _pageError = string.Empty;
        _pageSuccess = string.Empty;
        _isBusy = true;
        try
        {
            var success = await UserApiService.DeactivateAsync(userId);
            if (!success)
            {
                _pageError = "No se pudo desactivar el usuario. Asegúrese de que no sea el único administrador activo del sistema.";
            }
            else
            {
                _pageSuccess = "Usuario desactivado correctamente.";
            }
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ActivateUser(int userId)
    {
        if (_confirmModal is null) return;
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de que desea activar a este usuario? Volverá a tener acceso al sistema.", "Activar usuario", "Activar");
        if (!confirmed) return;

        _pageError = string.Empty;
        _pageSuccess = string.Empty;
        _isBusy = true;
        try
        {
            var success = await UserApiService.ActivateAsync(userId);
            if (!success)
            {
                _pageError = "No se pudo activar el usuario.";
            }
            else
            {
                _pageSuccess = "Usuario activado correctamente.";
            }
            await LoadDataAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
}
