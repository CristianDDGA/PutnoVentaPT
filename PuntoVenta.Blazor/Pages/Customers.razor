@page "/clientes"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using PuntoVenta.Blazor.Models
@using PuntoVenta.Blazor.Services
@inject CustomerApiService CustomerApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserModeService UserModeService
@inject IJSRuntime JSRuntime

<PageTitle>Clientes — Punto de Venta</PageTitle>

<div class="section-gap">
    <div>
        <h1 style="font-size:var(--font-size-2xl); font-weight:var(--font-weight-bold); color:var(--color-text-primary); margin-bottom:4px;">Clientes</h1>
        <p class="text-muted">Consulta el catálogo de clientes y administra su estado.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Filtros</span>
            @if (_isAdmin)
            {
                <button class="btn btn--secondary btn--sm ml-auto" @onclick="OpenCreateModal">
                    <i class="ph ph-plus"></i> Nuevo Cliente <kbd style="margin-left: 6px; font-size: 10px; padding: 2px 4px; background: rgba(0,0,0,0.1); border-radius: 4px; border: 1px solid rgba(0,0,0,0.05);">F2</kbd>
                </button>
            }
        </div>

        <div style="display:grid; grid-template-columns: 180px 1fr; gap:var(--spacing-md); align-items:flex-end;">
            <div class="field-group">
                <label class="field-label" style="display:flex; align-items:center; gap:6px;">
                    Documento
                    <span style="font-size:10px; background:rgba(99,102,241,0.15); color:#818cf8; border-radius:999px; padding:1px 8px; font-weight:normal; letter-spacing:0.03em;"><kbd style="background:transparent; border:none; padding:0; margin-right:2px; font-weight:bold;">F9</kbd> En vivo</span>
                </label>
                <input id="search-input" class="field-input" @bind="SearchDocument" @bind:event="oninput" @onkeydown="HandleTableKeyDown" placeholder="Ej: 1720..." />
            </div>
            <div class="field-group">
                <label class="field-label" style="display:flex; align-items:center; gap:6px;">
                    Apellido
                    <span style="font-size:10px; background:rgba(99,102,241,0.15); color:#818cf8; border-radius:999px; padding:1px 8px; font-weight:normal; letter-spacing:0.03em;">En vivo</span>
                </label>
                <input class="field-input" @bind="SearchLastName" @bind:event="oninput" @onkeydown="HandleTableKeyDown" placeholder="Buscar por apellido" />
            </div>
        </div>
        <div style="font-size: 11px; color: var(--color-text-secondary); margin-top: 12px; display: flex; gap: 12px; flex-wrap: wrap;">
            <span><kbd style="background: var(--color-bg-elevated); padding: 2px 4px; border-radius: 4px; border: 1px solid var(--color-border); font-family: monospace;">↓↑</kbd> Seleccionar fila</span>
            <span><kbd style="background: var(--color-bg-elevated); padding: 2px 4px; border-radius: 4px; border: 1px solid var(--color-border); font-family: monospace;">Enter</kbd> Editar</span>
            <span><kbd style="background: var(--color-bg-elevated); padding: 2px 4px; border-radius: 4px; border: 1px solid var(--color-border); font-family: monospace;">Supr</kbd> Eliminar</span>
            <span><kbd style="background: var(--color-bg-elevated); padding: 2px 4px; border-radius: 4px; border: 1px solid var(--color-border); font-family: monospace;">Alt + ⬅ ➡</kbd> Cambiar página</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert--error" : "alert--success")">@_message</div>
    }

    <div class="card">
        @if (_isLoading)
        {
            <div class="flex-center" style="padding:var(--spacing-xl);"><div class="loader-ring"></div></div>
        }
        else if ((_pagedResult?.Items.Count ?? 0) == 0)
        {
            <div class="empty-state">
                <p class="empty-state-text">No se encontraron clientes.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Documento</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Ciudad</th>
                            <th>Email</th>
                            <th class="align-center">Estado</th>
                            <th class="align-center">Modificado Por</th>
                            @if (_isAdmin)
                            {
                                <th class="align-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int index = 0; }
                        @foreach (var customer in _pagedResult?.Items ?? [])
                        {
                            var currentIndex = index++;
                            <tr class="@(_selectedIndex == currentIndex ? "row-selected" : "")">
                                <td class="font-mono">@customer.CustomerId</td>
                                <td>@customer.DocumentNumber</td>
                                <td>@customer.FirstName</td>
                                <td>@customer.LastName</td>
                                <td>@customer.City</td>
                                <td>@customer.Email</td>
                                <td class="align-center">
                                    <span class="badge @(customer.IsActive ? "badge--success" : "badge--error")">
                                        @(customer.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="align-center" style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                                    @(string.IsNullOrEmpty(customer.LastModifiedBy) ? "-" : customer.LastModifiedBy)
                                </td>
                                @if (_isAdmin)
                                {
                                    <td class="align-center">
                                        <div class="table-actions">
                                            <button class="btn btn--primary btn--sm" @onclick="() => OpenEditModal(customer)" disabled="@_isBusy">Editar</button>
                                            @if (customer.IsActive)
                                            {
                                                <button class="btn btn--danger btn--sm" @onclick="() => DeactivateCustomerAsync(customer)" disabled="@_isBusy">Desactivar</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn--success btn--sm" @onclick="() => ActivateAsync(customer.CustomerId)" disabled="@_isBusy">Activar</button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:var(--spacing-lg); align-items:center; gap:var(--spacing-md); flex-wrap:wrap;">
                <span class="text-muted">@(_pagedResult?.TotalCount ?? 0) cliente(s) · Página @_currentPage de @(_pagedResult?.TotalPages ?? 1)</span>
                <div style="display:flex; align-items:center; gap:var(--spacing-md);">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="text-muted" style="font-size:var(--font-size-xs);">Mostrar:</span>
                        <select class="field-input" style="width:75px; padding:4px 8px; font-size:var(--font-size-sm); cursor:pointer;" value="@_pageSize" @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                            <option value="30">30</option>
                        </select>
                    </div>
                    <div class="pagination">
                        <button class="pagination-btn" @onclick="() => LoadPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">‹ Anterior</button>
                        <button class="pagination-btn" @onclick="() => LoadPageAsync(_currentPage + 1)" disabled="@(_currentPage >= (_pagedResult?.TotalPages ?? 1))">Siguiente ›</button>
                    </div>
                </div>
            </div>
        }
    </div>
    <ConfirmModal @ref="_confirmModal" />
</div>

@if (_isCreateModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-box" style="max-width: 600px;" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">@(_isEditing ? "Editar cliente" : "Nuevo cliente")</span>
                <button class="btn btn--ghost btn--icon" @onclick="CloseCreateModalWithConfirmAsync"><i class="ph ph-x"></i></button>
            </div>
            <EditForm Model="_newCustomer" OnValidSubmit="SaveCustomerAsync">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap:var(--spacing-md);">
                        <div class="field-group">
                            <label class="field-label">Documento</label>
                            <InputText id="first-input" class="field-input" maxlength="10" @bind-Value="_newCustomer.DocumentNumber" @oninput="OnDocumentInput" inputmode="numeric" />
                            <ValidationMessage For="@(() => _newCustomer.DocumentNumber)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Nombre</label>
                            <InputText class="field-input" @bind-Value="_newCustomer.FirstName" />
                            <ValidationMessage For="@(() => _newCustomer.FirstName)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Apellido</label>
                            <InputText class="field-input" @bind-Value="_newCustomer.LastName" />
                            <ValidationMessage For="@(() => _newCustomer.LastName)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Teléfono</label>
                            <InputText class="field-input" maxlength="10" @bind-Value="_newCustomer.Phone" />
                            <ValidationMessage For="@(() => _newCustomer.Phone)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Dirección</label>
                            <InputText class="field-input" @bind-Value="_newCustomer.Address" />
                            <ValidationMessage For="@(() => _newCustomer.Address)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Ciudad</label>
                            <InputText class="field-input" @bind-Value="_newCustomer.City" />
                            <ValidationMessage For="@(() => _newCustomer.City)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group" style="grid-column: span 2;">
                            <label class="field-label">Email</label>
                            <InputText class="field-input" @bind-Value="_newCustomer.Email" />
                            <ValidationMessage For="@(() => _newCustomer.Email)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                    </div>
                    @if (_isEditing && !string.IsNullOrWhiteSpace(_lastModifiedBy))
                    {
                        <div style="margin-top:var(--spacing-md); font-size:var(--font-size-sm); color:var(--color-text-secondary); display:flex; align-items:center; gap:4px;">
                            <i class="ph ph-info"></i> Última modificación por: <strong>@_lastModifiedBy</strong> el @(_lastModifiedAt?.ToString("g") ?? "")
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_modalMessage))
                    {
                        <div class="alert @(_isModalError ? "alert--error" : "alert--success")" style="margin-top:var(--spacing-md);">@_modalMessage</div>
                    }
                </div>
                <div class="modal-footer" style="justify-content: flex-end;">
                    <button type="button" class="btn btn--ghost" @onclick="CloseCreateModalWithConfirmAsync">Cancelar</button>
                    <button type="submit" class="btn btn--success" disabled="@_isBusy">@(_isEditing ? "Guardar cambios" : "Crear cliente") <kbd style="margin-left: 6px; font-size: 10px; padding: 2px 4px; background: rgba(0,0,0,0.1); border-radius: 4px; border: 1px solid rgba(0,0,0,0.05);">Ctrl+Enter</kbd></button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private ConfirmModal _confirmModal = default!;
    private PagedResultModel<CustomerModel>? _pagedResult;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _selectedIndex = -1;
    private string _searchDocument = string.Empty;
    private string _searchLastName = string.Empty;
    private bool _isLoading;
    private bool _isBusy;
    private bool _isAdmin;
    private string? _message;
    private bool _isError;
    private bool _isCreateModalOpen;
    private string? _modalMessage;
    private bool _isModalError;
    private bool _isEditing;
    private int _editingCustomerId;
    private string? _lastModifiedBy;
    private DateTime? _lastModifiedAt;
    private readonly CreateCustomerModel _newCustomer = new();
    private System.Threading.Timer? _debounceTimer;

    private string SearchDocument
    {
        get => _searchDocument;
        set
        {
            if (_searchDocument != value)
            {
                _searchDocument = value;
                OnSearchInput();
            }
        }
    }

    private string SearchLastName
    {
        get => _searchLastName;
        set
        {
            if (_searchLastName != value)
            {
                _searchLastName = value;
                OnSearchInput();
            }
        }
    }

    private void OnSearchInput()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadPageAsync(1);
                StateHasChanged();
            });
        }, null, 350, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        UserModeService.OnShortcutPressed -= HandleShortcut;
        _debounceTimer?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        UserModeService.OnShortcutPressed += HandleShortcut;
        await ResolveRoleAsync();
        await LoadPageAsync(1);
    }

    private async void HandleShortcut(string key)
    {
        if (key == "Escape" && _isCreateModalOpen && !_confirmModal.IsVisible)
        {
            await InvokeAsync(CloseCreateModalWithConfirmAsync);
        }
        else if (key == "F2" && _isAdmin && !_isCreateModalOpen)
        {
            await InvokeAsync(() => { OpenCreateModal(); StateHasChanged(); });
        }
        else if (key == "F9" && !_isCreateModalOpen)
        {
            await InvokeAsync(() => JSRuntime.InvokeVoidAsync("pvKeyboardBridge.focusElement", "search-input"));
        }
        else if (key == "Delete" && !_isCreateModalOpen && _selectedIndex >= 0 && _isAdmin)
        {
            var items = _pagedResult?.Items?.ToList();
            if (items != null && _selectedIndex < items.Count)
            {
                await InvokeAsync(() => DeactivateCustomerAsync(items[_selectedIndex]));
            }
        }
        else if (key == "AltArrowRight" && !_isCreateModalOpen)
        {
            if (_currentPage < (_pagedResult?.TotalPages ?? 1)) await InvokeAsync(() => LoadPageAsync(_currentPage + 1));
        }
        else if (key == "AltArrowLeft" && !_isCreateModalOpen)
        {
            if (_currentPage > 1) await InvokeAsync(() => LoadPageAsync(_currentPage - 1));
        }
        else if (key == "CtrlEnter" && _isCreateModalOpen)
        {
            await InvokeAsync(SaveCustomerAsync);
        }
    }

    private void HandleTableKeyDown(KeyboardEventArgs e)
    {
        var items = _pagedResult?.Items?.ToList();
        if (items == null || !items.Any()) return;

        if (e.Key == "ArrowDown")
        {
            _selectedIndex = Math.Min(_selectedIndex + 1, items.Count - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = Math.Max(_selectedIndex - 1, 0);
        }
        else if (e.Key == "Enter" && _selectedIndex >= 0 && _isAdmin)
        {
            OpenEditModal(items[_selectedIndex]);
        }
    }

    private async Task ResolveRoleAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");
    }

    private async Task LoadPageAsync(int page)
    {
        _isLoading = true;
        _selectedIndex = -1;
        _currentPage = page < 1 ? 1 : page;

        try
        {
            _pagedResult = await CustomerApiService.SearchPagedAsync(
                documentNumber: string.IsNullOrWhiteSpace(_searchDocument) ? null : _searchDocument.Trim(),
                lastName: string.IsNullOrWhiteSpace(_searchLastName) ? null : _searchLastName.Trim(),
                page: _currentPage,
                pageSize: _pageSize);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _isCreateModalOpen = true;
        _modalMessage = null;
        _lastModifiedBy = null;
        _lastModifiedAt = null;
        _newCustomer.DocumentNumber = string.Empty;
        _newCustomer.FirstName = string.Empty;
        _newCustomer.LastName = string.Empty;
        _newCustomer.Phone = null;
        _newCustomer.Address = null;
        _newCustomer.City = null;
        _newCustomer.Email = null;
        _ = InvokeAsync(() => JSRuntime.InvokeVoidAsync("pvKeyboardBridge.focusElement", "first-input"));
    }

    private void OpenEditModal(CustomerModel customer)
    {
        _isEditing = true;
        _editingCustomerId = customer.CustomerId;
        _isCreateModalOpen = true;
        _modalMessage = null;
        
        _lastModifiedBy = customer.LastModifiedBy;
        _lastModifiedAt = customer.LastModifiedAt;
        
        _newCustomer.DocumentNumber = customer.DocumentNumber;
        _newCustomer.FirstName = customer.FirstName;
        _newCustomer.LastName = customer.LastName;
        _newCustomer.Phone = customer.Phone;
        _newCustomer.Address = customer.Address;
        _newCustomer.City = customer.City;
        _newCustomer.Email = customer.Email;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private async Task CloseCreateModalWithConfirmAsync()
    {
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de descartar los cambios? Se perderán los datos ingresados.", "Cancelar edición", "Sí, descartar");
        if (confirmed)
        {
            _isCreateModalOpen = false;
            StateHasChanged();
        }
    }

    private async Task SaveCustomerAsync()
    {
        _isBusy = true;
        _modalMessage = null;

        try
        {
            if (_isEditing)
            {
                var updateModel = new UpdateCustomerModel
                {
                    DocumentNumber = _newCustomer.DocumentNumber,
                    FirstName = _newCustomer.FirstName,
                    LastName = _newCustomer.LastName,
                    Phone = _newCustomer.Phone,
                    Address = _newCustomer.Address,
                    City = _newCustomer.City,
                    Email = _newCustomer.Email
                };
                var success = await CustomerApiService.UpdateAsync(_editingCustomerId, updateModel);
                if (!success)
                {
                    _modalMessage = "No se pudo actualizar el cliente.";
                    _isModalError = true;
                    return;
                }
                SetMessage("Cliente actualizado correctamente.", false);
            }
            else
            {
                var saved = await CustomerApiService.CreateAsync(_newCustomer);
                if (saved is null)
                {
                    _modalMessage = "No se pudo crear el cliente.";
                    _isModalError = true;
                    return;
                }
                SetMessage("Cliente creado correctamente.", false);
            }

            CloseCreateModal();
            await LoadPageAsync(_currentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ActivateAsync(int customerId)
    {
        _isBusy = true;
        SetMessage(null, false);

        try
        {
            var success = await CustomerApiService.ActivateAsync(customerId);
            SetMessage(success ? "Cliente activado." : "No se pudo activar el cliente.", !success);
            await LoadPageAsync(_currentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = size;
            await LoadPageAsync(1);
        }
    }

    private async Task DeactivateCustomerAsync(CustomerModel customer)
    {
        var confirmed = await _confirmModal.ShowAsync(
            message: $"¿Está seguro de que desea desactivar al cliente '{customer.FullName}'?",
            title: "Desactivar Cliente",
            confirmText: "Sí, desactivar");

        if (!confirmed) return;

        _isBusy = true;
        SetMessage(null, false);

        try
        {
            var success = await CustomerApiService.DeactivateAsync(customer.CustomerId);
            if (success)
            {
                SetMessage("Cliente desactivado.", false);
                await LoadPageAsync(_currentPage);
            }
            else
            {
                SetMessage("No se pudo desactivar al cliente.", true);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnDocumentInput(ChangeEventArgs e)
    {
        var s = e.Value?.ToString() ?? string.Empty;
        var digits = new string(s.Where(char.IsDigit).ToArray());
        if (digits.Length > 10) digits = digits.Substring(0, 10);
        _newCustomer.DocumentNumber = digits;
    }

    private void SetMessage(string? message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
}