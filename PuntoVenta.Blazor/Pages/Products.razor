@page "/productos"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using PuntoVenta.Blazor.Models
@using PuntoVenta.Blazor.Services
@inject ProductApiService ProductApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserModeService UserModeService

<PageTitle>Productos — Punto de Venta</PageTitle>

<div class="section-gap">
    <div>
        <h1 style="font-size:var(--font-size-2xl); font-weight:var(--font-weight-bold); color:var(--color-text-primary); margin-bottom:4px;">Productos</h1>
        <p class="text-muted">Administra catálogo, stock y estado de productos.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Filtros</span>
            @if (_isAdmin)
            {
                <button class="btn btn--secondary btn--sm ml-auto" @onclick="OpenCreateModal">
                    <i class="ph ph-plus"></i> Nuevo Producto
                </button>
            }
        </div>

        <div style="display:grid; grid-template-columns: 1fr auto; gap:var(--spacing-md); align-items:flex-end;">
            <div class="field-group">
                <label class="field-label" style="display:flex; align-items:center; gap:6px;">
                    Nombre
                    <span style="font-size:10px; background:rgba(99,102,241,0.15); color:#818cf8; border-radius:999px; padding:1px 8px; font-weight:normal; letter-spacing:0.03em;">Búsqueda en vivo</span>
                </label>
                <input class="field-input" @bind="SearchName" @bind:event="oninput" placeholder="Buscar producto..." />
            </div>
            <div class="field-group" style="flex-direction:row; align-items:center; gap:var(--spacing-sm);">
                <input type="checkbox" checked="@_onlyInStock" @onchange="OnOnlyInStockChanged" />
                <label class="field-label" style="margin:0;">Solo con stock</label>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert--error" : "alert--success")">@_message</div>
    }

    <div class="card">
        @if (_isLoading)
        {
            <div class="flex-center" style="padding:var(--spacing-xl);"><div class="loader-ring"></div></div>
        }
        else if ((_pagedResult?.Items.Count ?? 0) == 0)
        {
            <div class="empty-state">
                <p class="empty-state-text">No se encontraron productos.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th class="align-right">Precio</th>
                            <th class="align-right">Stock</th>
                            <th class="align-center">Estado</th>
                            <th class="align-center">Modificado Por</th>
                            @if (_isAdmin)
                            {
                                <th class="align-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in _pagedResult?.Items ?? [])
                        {
                            <tr>
                                <td class="font-mono">@product.ProductId</td>
                                <td>@product.Name</td>
                                <td class="td-numeric">$@product.Price.ToString("N2")</td>
                                <td class="td-numeric">@product.Stock</td>
                                <td class="align-center">
                                    <span class="badge @(product.IsActive ? "badge--success" : "badge--error")">
                                        @(product.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="align-center" style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                                    @(string.IsNullOrEmpty(product.LastModifiedBy) ? "-" : product.LastModifiedBy)
                                </td>
                                @if (_isAdmin)
                                {
                                    <td class="align-center">
                                        @if (product.IsActive)
                                        {
                                            <button class="btn btn--primary btn--sm" @onclick="() => OpenEditModal(product)" disabled="@_isBusy" style="margin-right: 4px;">Editar</button>
                                            <button class="btn btn--danger btn--sm" @onclick="() => DeleteProductAsync(product)" disabled="@_isBusy">Eliminar</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn--success btn--sm" @onclick="() => ActivateAsync(product.ProductId)" disabled="@_isBusy">Activar</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:var(--spacing-lg); align-items:center; gap:var(--spacing-md); flex-wrap:wrap;">
                <span class="text-muted">@(_pagedResult?.TotalCount ?? 0) producto(s) · Página @_currentPage de @(_pagedResult?.TotalPages ?? 1)</span>
                <div style="display:flex; align-items:center; gap:var(--spacing-md);">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="text-muted" style="font-size:var(--font-size-xs);">Mostrar:</span>
                        <select class="field-input" style="width:75px; padding:4px 8px; font-size:var(--font-size-sm); cursor:pointer;" value="@_pageSize" @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                            <option value="30">30</option>
                        </select>
                    </div>
                    <div class="pagination">
                        <button class="pagination-btn" @onclick="() => LoadPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">‹ Anterior</button>
                        <button class="pagination-btn" @onclick="() => LoadPageAsync(_currentPage + 1)" disabled="@(_currentPage >= (_pagedResult?.TotalPages ?? 1))">Siguiente ›</button>
                    </div>
                </div>
            </div>
        }
    </div>
    <ConfirmModal @ref="_confirmModal" />
</div>

@if (_isCreateModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-header">
                <span class="modal-title">@(_isEditing ? "Editar Producto" : "Nuevo Producto")</span>
                <button class="btn btn--ghost btn--icon" @onclick="CloseCreateModalWithConfirmAsync"><i class="ph ph-x"></i></button>
            </div>
            <EditForm Model="_newProduct" OnValidSubmit="SaveProductAsync">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="form-grid form-grid-1">
                        <div class="field-group">
                            <label class="field-label">Nombre</label>
                            <InputText class="field-input" @bind-Value="_newProduct.Name" />
                            <ValidationMessage For="@(() => _newProduct.Name)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Precio</label>
                            <InputNumber class="field-input" @bind-Value="_newProduct.Price" />
                            <ValidationMessage For="@(() => _newProduct.Price)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                        <div class="field-group">
                            <label class="field-label">Stock</label>
                            <InputNumber class="field-input" @bind-Value="_newProduct.Stock" />
                            <ValidationMessage For="@(() => _newProduct.Stock)" class="alert alert--error" style="margin-top:4px; padding:4px;" />
                        </div>
                    </div>
                    @if (_isEditing && !string.IsNullOrWhiteSpace(_lastModifiedBy))
                    {
                        <div style="margin-top:var(--spacing-md); font-size:var(--font-size-sm); color:var(--color-text-secondary); display:flex; align-items:center; gap:4px;">
                            <i class="ph ph-info"></i> Última modificación por: <strong>@_lastModifiedBy</strong> el @(_lastModifiedAt?.ToString("g") ?? "")
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_modalMessage))
                    {
                        <div class="alert @(_isModalError ? "alert--error" : "alert--success")" style="margin-top:var(--spacing-md);">@_modalMessage</div>
                    }
                </div>
                <div class="modal-footer" style="justify-content: flex-end;">
                    <button type="button" class="btn btn--ghost" @onclick="CloseCreateModalWithConfirmAsync">Cancelar</button>
                    <button type="submit" class="btn btn--success" disabled="@_isBusy">@(_isEditing ? "Guardar cambios" : "Crear producto")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private ConfirmModal _confirmModal = default!;
    private PagedResultModel<ProductModel>? _pagedResult;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private string _searchName = string.Empty;
    private bool _onlyInStock;
    private bool _isLoading;
    private bool _isBusy;
    private bool _isAdmin;
    private string? _message;
    private bool _isError;
    private bool _isCreateModalOpen;
    private string? _modalMessage;
    private bool _isModalError;
    private readonly CreateProductModel _newProduct = new();
    private System.Threading.Timer? _debounceTimer;

    private string SearchName
    {
        get => _searchName;
        set
        {
            if (_searchName != value)
            {
                _searchName = value;
                OnSearchInput();
            }
        }
    }

    private async Task OnOnlyInStockChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var isChecked))
        {
            _onlyInStock = isChecked;
            await LoadPageAsync(1);
        }
    }

    private void OnSearchInput()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadPageAsync(1);
                StateHasChanged();
            });
        }, null, 350, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        UserModeService.OnShortcutPressed -= HandleShortcut;
        _debounceTimer?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        UserModeService.OnShortcutPressed += HandleShortcut;
        await ResolveRoleAsync();
        await LoadPageAsync(1);
    }

    private async void HandleShortcut(string key)
    {
        if (key == "Escape" && _isCreateModalOpen && !_confirmModal.IsVisible)
        {
            await InvokeAsync(CloseCreateModalWithConfirmAsync);
        }
    }

    private async Task ResolveRoleAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");
    }

    private async Task LoadPageAsync(int page)
    {
        _isLoading = true;
        _currentPage = page < 1 ? 1 : page;

        try
        {
            _pagedResult = await ProductApiService.SearchPagedAsync(
                name: string.IsNullOrWhiteSpace(_searchName) ? null : _searchName.Trim(),
                page: _currentPage,
                pageSize: _pageSize,
                onlyInStock: _onlyInStock);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool _isEditing;
    private int _editingProductId;
    private string? _lastModifiedBy;
    private DateTime? _lastModifiedAt;

    private void OpenCreateModal()
    {
        _isCreateModalOpen = true;
        _isEditing = false;
        _modalMessage = null;
        _lastModifiedBy = null;
        _lastModifiedAt = null;
        _newProduct.Name = string.Empty;
        _newProduct.Price = 0;
        _newProduct.Stock = 0;
    }

    private void OpenEditModal(ProductModel product)
    {
        _isCreateModalOpen = true;
        _isEditing = true;
        _editingProductId = product.ProductId;
        _modalMessage = null;
        _lastModifiedBy = product.LastModifiedBy;
        _lastModifiedAt = product.LastModifiedAt;
        _newProduct.Name = product.Name;
        _newProduct.Price = product.Price;
        _newProduct.Stock = product.Stock;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private async Task CloseCreateModalWithConfirmAsync()
    {
        var confirmed = await _confirmModal.ShowAsync("¿Está seguro de descartar los cambios? Se perderán los datos ingresados.", "Cancelar edición", "Sí, descartar");
        if (confirmed)
        {
            _isCreateModalOpen = false;
            StateHasChanged();
        }
    }

    private async Task SaveProductAsync()
    {
        _isBusy = true;
        _modalMessage = null;

        try
        {
            if (_isEditing)
            {
                var saved = await ProductApiService.UpdateAsync(_editingProductId, _newProduct);
                if (saved is null)
                {
                    _modalMessage = "No se pudo actualizar el producto.";
                    _isModalError = true;
                    return;
                }
                SetMessage("Producto actualizado correctamente.", false);
            }
            else
            {
                var saved = await ProductApiService.CreateAsync(_newProduct);
                if (saved is null)
                {
                    _modalMessage = "No se pudo crear el producto.";
                    _isModalError = true;
                    return;
                }
                SetMessage("Producto creado correctamente.", false);
            }

            CloseCreateModal();
            await LoadPageAsync(_currentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ActivateAsync(int productId)
    {
        _isBusy = true;
        SetMessage(null, false);

        try
        {
            var success = await ProductApiService.ActivateAsync(productId);
            SetMessage(success ? "Producto activado." : "No se pudo activar el producto.", !success);
            await LoadPageAsync(_currentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = size;
            await LoadPageAsync(1);
        }
    }

    private async Task DeleteProductAsync(ProductModel product)
    {
        var confirmed = await _confirmModal.ShowAsync(
            message: $"¿Está seguro de que desea eliminar el producto '{product.Name}'?",
            title: "Eliminar Producto",
            confirmText: "Sí, eliminar");

        if (!confirmed) return;

        _isBusy = true;
        SetMessage(null, false);

        try
        {
            var result = await ProductApiService.DeleteAsync(product.ProductId);
            if (result is not null && result.Success)
            {
                SetMessage(result.Message, false);
                await LoadPageAsync(_currentPage);
            }
            else
            {
                SetMessage(result?.Message ?? "No se pudo eliminar el producto.", true);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SetMessage(string? message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
}