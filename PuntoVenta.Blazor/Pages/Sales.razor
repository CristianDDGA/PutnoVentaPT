    // ── Keyboard support and user modes C# implementation ───────────────
    private string _directCustomerDoc = string.Empty;
    private int? _directProductId;

    private async void HandleShortcut(string key)
    {
        await InvokeAsync(async () => {
            if (key == "F2")
            {
                if (_isProductModalOpen || _isSaleHistoryModalOpen) return;
                await OpenCustomerModal();
                StateHasChanged();
            }
            else if (key == "F4")
            {
                if (_isCustomerModalOpen || _isSaleHistoryModalOpen) return;
                await OpenProductModal();
                StateHasChanged();
            }
            else if (key == "F6")
            {
                await AddProductToSaleAsync();
                StateHasChanged();
            }
            else if (key == "F8")
            {
                await CancelSale();
                StateHasChanged();
            }
            else if (key == "F9")
            {
                await CreateSale();
                StateHasChanged();
            }
            else if (key == "Escape")
            {
                if (_isCustomerModalOpen)
                {
                    CloseCustomerModal();
                    StateHasChanged();
                }
                else if (_isProductModalOpen)
                {
                    CloseProductModal();
                    StateHasChanged();
                }
                else if (_isSaleHistoryModalOpen)
                {
                    CloseSaleHistoryModal();
                    StateHasChanged();
                }
                else if (_isPdfPreviewModalOpen)
                {
                    ClosePdfPreviewModal();
                    StateHasChanged();
                }
            }
            else if (key == "ArrowDown")
            {
                MoveModalSelection(1);
            }
            else if (key == "ArrowUp")
            {
                MoveModalSelection(-1);
            }
            else if (key == "Enter")
            {
                SelectActiveModalRow();
            }
        });
    }

    private async Task HandleDirectCustomerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _errorMessage = string.Empty;
            _successMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(_directCustomerDoc))
            {
                _errorMessage = "Por favor, ingrese un documento válido.";
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "error");
                return;
            }

            var result = await CustomerApiService.SearchPagedAsync(
                customerId: null,
                documentNumber: _directCustomerDoc,
                lastName: null,
                page: 1,
                pageSize: 1,
                onlyActive: true);

            if (result != null && result.Items.Count > 0)
            {
                _selectedCustomer = result.Items[0];
                _directCustomerDoc = string.Empty;
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "success");
                _errorMessage = string.Empty;
                TriggerAutoSave();
                
                await FocusElement("product-id-input");
            }
            else
            {
                _errorMessage = $"No se encontró ningún cliente activo con el documento '{_directCustomerDoc}'.";
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "error");
            }
        }
    }

    private async Task HandleDirectProductKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _errorMessage = string.Empty;
            _successMessage = string.Empty;

            if (!_directProductId.HasValue || _directProductId.Value <= 0)
            {
                _errorMessage = "Por favor, ingrese un ID de producto válido.";
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "error");
                return;
            }

            var product = await ProductApiService.GetByIdAsync(_directProductId.Value);

            if (product != null && product.Stock > 0 && product.IsActive)
            {
                _selectedProduct = product;
                _selectedQuantity = 1;
                _directProductId = null;
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "success");
                
                await FocusElement("product-qty-input");
            }
            else if (product != null && product.Stock <= 0)
            {
                _errorMessage = $"El producto '{product.Name}' está agotado.";
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "error");
            }
            else
            {
                _errorMessage = $"No se encontró ningún producto activo con ID {_directProductId.Value}.";
                await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.triggerSound", "error");
            }
        }
    }

    private async Task HandleQuantityInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_selectedProduct != null && _selectedQuantity > 0 && _selectedQuantity <= _selectedProduct.Stock)
            {
                await AddProductToSaleAsync();
            }
        }
    }

    private async Task AddProductToSaleAsync()
    {
        AddProductToSale();
    }

    private async Task FocusElement(string id)
    {
        await JSRuntime.InvokeVoidAsync("pvKeyboardBridge.focusElement", id);
    }

    private void MoveModalSelection(int direction)
    {
        if (_isCustomerModalOpen)
        {
            if (_customerPagedResult?.Items == null || _customerPagedResult.Items.Count == 0) return;
            int currentIndex = _selectedCustomerRow == null ? -1 : _customerPagedResult.Items.IndexOf(_selectedCustomerRow);
            int newIndex = currentIndex + direction;
            if (newIndex < 0) newIndex = 0;
            if (newIndex >= _customerPagedResult.Items.Count) newIndex = _customerPagedResult.Items.Count - 1;
            _selectedCustomerRow = _customerPagedResult.Items[newIndex];
            StateHasChanged();
        }
        else if (_isProductModalOpen)
        {
            if (_productPagedResult?.Items == null || _productPagedResult.Items.Count == 0) return;
            int currentIndex = _selectedProductRow == null ? -1 : _productPagedResult.Items.IndexOf(_selectedProductRow);
            int newIndex = currentIndex + direction;
            if (newIndex < 0) newIndex = 0;
            if (newIndex >= _productPagedResult.Items.Count) newIndex = _productPagedResult.Items.Count - 1;
            _selectedProductRow = _productPagedResult.Items[newIndex];
            StateHasChanged();
        }
    }

    private void SelectActiveModalRow()
    {
        if (_isCustomerModalOpen && _selectedCustomerRow != null)
        {
            SelectCustomerAndClose(_selectedCustomerRow);
        }
        else if (_isProductModalOpen && _selectedProductRow != null)
        {
            if (_selectedProductRow.Stock > 0)
            {
                SelectProductAndClose(_selectedProductRow);
                _ = FocusElement("product-qty-input");
            }
        }
    }
