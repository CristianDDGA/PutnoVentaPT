@page "/auditoria"
@attribute [Authorize]
@using PuntoVenta.Blazor.Models
@using PuntoVenta.Blazor.Services
@inject SaleApiService SaleApiService
@inject IJSRuntime JSRuntime

<PageTitle>Auditoría — Punto de Venta</PageTitle>

<div class="section-gap">
    <div>
        <h1 style="font-size:var(--font-size-2xl); font-weight:var(--font-weight-bold); color:var(--color-text-primary); margin-bottom:4px;">Módulo de Auditoría de Ventas</h1>
        <p class="text-muted">Herramienta exclusiva para consulta de información inmutable de facturación.</p>
    </div>

    <!-- SEARCH BAR -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Búsqueda de Factura</span>
        </div>
        <div style="display:flex; gap:var(--spacing-md); align-items:flex-end;">
            <div class="field-group" style="flex:1; margin-bottom:0;">
                <label class="field-label">Ingrese el Número de Factura</label>
                <input type="number" 
                       class="field-input"
                       placeholder="Ej: 1001"
                       @bind="_searchSaleId"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
            </div>
            <button class="btn btn--primary" style="height:42px;" @onclick="SearchSaleAsync" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span><i class="ph ph-spinner ph-spin" style="margin-right:4px;"></i> Consultando...</span>
                }
                else
                {
                    <span><i class="ph ph-magnifying-glass" style="margin-right:4px;"></i> Buscar</span>
                }
            </button>
        </div>
        
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert--error" style="margin-top:var(--spacing-md);">
                @_errorMessage
            </div>
        }
    </div>

    <!-- RESULT AREA -->
    @if (_sale is not null)
    {
        <div class="card">
            <div class="card-header">
                <span class="card-title">Resultado de la Auditoría</span>
                <button class="btn btn--secondary btn--sm ml-auto" @onclick="PreviewPdfAsync">
                    <i class="ph ph-file-pdf"></i> Generar PDF Original
                </button>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--spacing-md); background: rgba(0,0,0,0.02); padding: var(--spacing-md); border-radius: var(--border-radius-md); border: 1px solid var(--color-border); margin-bottom: var(--spacing-lg);">
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Factura Nº:</strong>
                    <div style="font-size: var(--font-size-lg); font-weight: bold; margin-top: 4px; color: var(--color-text-primary);">#@_sale.SaleId.ToString("D6")</div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Estado:</strong>
                    <div style="margin-top: 4px;">
                        <span class="badge @(_sale.Status == "Completada" ? "badge--success" : "badge--error")">@_sale.Status</span>
                    </div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Cliente Registrado:</strong>
                    <div style="font-size: var(--font-size-base); margin-top: 4px; color: var(--color-text-primary);">@_sale.CustomerName</div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Vendedor Autorizado:</strong>
                    <div style="font-size: var(--font-size-base); margin-top: 4px; color: var(--color-text-primary);">@(string.IsNullOrEmpty(_sale.SellerName) ? "N/A" : _sale.SellerName)</div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Creado Por (Usuario):</strong>
                    <div style="font-size: var(--font-size-base); margin-top: 4px; color: var(--color-text-primary);">@(string.IsNullOrEmpty(_sale.CreatedByUsername) ? "N/A" : _sale.CreatedByUsername)</div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Fecha de Operación:</strong>
                    <div style="font-size: var(--font-size-base); margin-top: 4px; color: var(--color-text-primary);">@_sale.SaleDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                </div>
                <div>
                    <strong style="color: var(--color-text-secondary); font-size: var(--font-size-sm); display: block;">Método de Pago:</strong>
                    <div style="font-size: var(--font-size-base); margin-top: 4px; color: var(--color-text-primary);">@_sale.PaymentType</div>
                </div>
            </div>

            <h3 style="font-size: var(--font-size-base); color: var(--color-text-primary); border-bottom: 1px solid var(--color-border); padding-bottom: 8px; margin-bottom: 16px;">Productos Vendidos</h3>
            
            <div style="overflow-x:auto; margin-bottom: var(--spacing-lg);">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Cód.</th>
                            <th>Descripción</th>
                            <th class="align-right">Precio Unit.</th>
                            <th class="align-right">Cant.</th>
                            <th class="align-right">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in _sale.Details)
                        {
                            <tr>
                                <td class="font-mono text-muted">@detail.ProductId</td>
                                <td style="font-weight: 500;">@detail.ProductName</td>
                                <td class="td-numeric">$@detail.UnitPrice.ToString("N2")</td>
                                <td class="td-numeric">@detail.Quantity</td>
                                <td class="td-numeric" style="font-weight: bold;">
                                    $@detail.Subtotal.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: flex-end;">
                <div style="width: 250px; background: rgba(0,0,0,0.01); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); padding: var(--spacing-md);">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--color-text-secondary);">
                        <span>Subtotal:</span>
                        <span>$@_sale.Subtotal.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--color-text-secondary);">
                        <span>IVA (12%):</span>
                        <span>$@_sale.TaxAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--color-border); font-weight: bold; font-size: var(--font-size-lg); color: var(--color-text-primary);">
                        <span>TOTAL:</span>
                        <span>$@_sale.Total.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL: PDF PREVIEW -->
@if (_isPdfPreviewModalOpen)
{
    <div class="modal-overlay" @onclick="ClosePdfPreviewModal">
        <div class="modal-box" style="max-width: 1000px; height: 90vh; display: flex; flex-direction: column; padding: 0;" @onclick:stopPropagation>
            <div class="modal-header" style="background: #111; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0;">
                <span class="modal-title" style="color: white;">Documento de Auditoría</span>
                <div style="display: flex; gap: 10px;">
                    <button class="btn btn--primary btn--sm" @onclick="DownloadCurrentPreviewPdf">
                        <i class="ph ph-download"></i> Descargar
                    </button>
                    <button class="btn btn--ghost btn--icon" style="color: white;" @onclick="ClosePdfPreviewModal">
                        <i class="ph ph-x"></i>
                    </button>
                </div>
            </div>
            <div style="flex: 1; padding: 0; background: #525659;">
                <iframe src="@_pdfPreviewUrl" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>
    </div>
}

@code {
    private int? _searchSaleId;
    private SaleModel? _sale;
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;

    // PDF Preview state
    private bool _isPdfPreviewModalOpen = false;
    private string _pdfPreviewUrl = string.Empty;
    private string _pdfPreviewBase64 = string.Empty;
    private string _pdfPreviewFileName = string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchSaleAsync();
        }
    }

    private async Task SearchSaleAsync()
    {
        _errorMessage = string.Empty;
        _sale = null;

        if (!_searchSaleId.HasValue || _searchSaleId.Value <= 0)
        {
            _errorMessage = "Por favor, ingrese un número de factura válido.";
            return;
        }

        _isLoading = true;
        try
        {
            var pagedResult = await SaleApiService.SearchPagedAsync(saleId: _searchSaleId.Value, customerName: null, page: 1, pageSize: 1, excludeVoided: false);
            
            if (pagedResult?.Items != null && pagedResult.Items.Count > 0)
            {
                _sale = pagedResult.Items.First();
            }
            else
            {
                _errorMessage = $"No se encontró la factura #{_searchSaleId.Value.ToString("D6")}.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Error al consultar: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviewPdfAsync()
    {
        if (_sale is null) return;

        var pdfBytes = await SaleApiService.GetPdfAsync(_sale.SaleId);
        if (pdfBytes is null)
        {
            _errorMessage = "No se pudo generar el PDF.";
            return;
        }

        _pdfPreviewBase64 = Convert.ToBase64String(pdfBytes);
        _pdfPreviewUrl = $"data:application/pdf;base64,{_pdfPreviewBase64}";
        _pdfPreviewFileName = $"Auditoria_Factura_{_sale.SaleId:D6}.pdf";
        _isPdfPreviewModalOpen = true;
    }

    private void ClosePdfPreviewModal()
    {
        _isPdfPreviewModalOpen = false;
        _pdfPreviewUrl = string.Empty;
        _pdfPreviewBase64 = string.Empty;
    }

    private async Task DownloadCurrentPreviewPdf()
    {
        if (!string.IsNullOrEmpty(_pdfPreviewBase64))
        {
            await JSRuntime.InvokeVoidAsync("downloadPdf", _pdfPreviewBase64, _pdfPreviewFileName);
        }
    }
}
