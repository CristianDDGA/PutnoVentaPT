@implements IDisposable
@inject PuntoVenta.Blazor.Services.UserModeService UserModeService

@if (_isVisible)
{
    <div class="modal-overlay confirm-modal-overlay">
        <div class="modal-box confirm-modal-box" @onclick:stopPropagation>

            <div class="confirm-modal-icon">
                <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
            </div>

            <div class="confirm-modal-content">
                <h3 class="confirm-modal-title">@Title</h3>
                <p class="confirm-modal-message">@Message</p>
            </div>

            <div class="confirm-modal-actions">
                <button class="btn btn--ghost" @onclick="OnCancel">Cancelar</button>
                <button @ref="_confirmButton" class="btn btn--danger-solid" @onclick="OnConfirm">@ConfirmText</button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public string Title       { get; set; } = "¿Confirmar acción?";
    [Parameter] public string Message     { get; set; } = "Esta acción no se puede deshacer.";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";

    private bool _isVisible = false;
    private TaskCompletionSource<bool>? _tcs;
    private ElementReference _confirmButton;

    public bool IsVisible => _isVisible;

    protected override void OnInitialized()
    {
        UserModeService.OnShortcutPressed += HandleShortcut;
    }

    public void Dispose()
    {
        UserModeService.OnShortcutPressed -= HandleShortcut;
    }

    private void HandleShortcut(string key)
    {
        if (!_isVisible) return;

        if (key == "Enter")
        {
            InvokeAsync(() => { OnConfirm(); StateHasChanged(); });
        }
        else if (key == "Escape")
        {
            InvokeAsync(() => { OnCancel(); StateHasChanged(); });
        }
    }

    /// <summary>Shows the modal and returns true if user confirms, false if cancelled.</summary>
    public async Task<bool> ShowAsync(string message, string title = "¿Confirmar acción?", string confirmText = "Confirmar")
    {
        if (_isVisible && _tcs != null) return await _tcs.Task;

        Title       = title;
        Message     = message;
        ConfirmText = confirmText;
        _isVisible  = true;
        _tcs        = new TaskCompletionSource<bool>();
        StateHasChanged();
        
        // Auto-focus the confirm button so 'Enter' works even if an input was focused
        await Task.Delay(50);
        try { await _confirmButton.FocusAsync(); } catch { }

        return await _tcs.Task;
    }

    private void OnConfirm()
    {
        _isVisible = false;
        _tcs?.SetResult(true);
    }

    private void OnCancel()
    {
        _isVisible = false;
        _tcs?.SetResult(false);
    }
}
